[Unit]
Description=Utterlog Bun application
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
Environment=NODE_ENV=production
# 进程时区必须与站点时区（site_timezone，默认 Asia/Shanghai）一致：
# ul_posts.published_at 是 timestamp without time zone，postgres.js 用 new Date(x)
# 按**进程本地时区**解析，服务器跑 UTC 时会凭空多出 8 小时并把偏移写回库。
Environment=TZ=Asia/Shanghai
ExecStart=__BUN_BIN__ run app/start/src/backend/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027

[Install]
WantedBy=multi-user.target
